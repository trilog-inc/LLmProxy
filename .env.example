# LLM Proxy Configuration
# Copy this file to .env and modify as needed

# Target SGLang server URL
SGLANG_API_BASE=http://10.0.0.5:60000/v1

# Proxy server settings
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=llm_proxy.log
ENABLE_FILE_LOGGING=false

# Timeout settings (seconds)
FORWARD_TIMEOUT=300

# Queue settings for single-backend server handling
# The SGLang backend can only handle 1 request at a time, so we need to queue requests
MAX_CONCURRENT_REQUESTS=1          # Maximum requests processed by backend simultaneously
MAX_QUEUE_SIZE=100                 # Maximum requests to queue before rejecting (503 error)
QUEUE_TIMEOUT=600                  # Maximum time (seconds) to wait in queue before timeout

# Streaming tool-call transformer (optional)
# When enabled, extracts tool calls from both reasoning_content and content fields
# and converts them into properly structured tool_calls in the response
ENABLE_STREAMING_TOOL_PARSER=true
